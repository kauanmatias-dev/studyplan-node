<aside class="sidebar">
    <div class="sidebar-logo">
        <div class="sidebar-logo-icon">📚</div>
        <span class="sidebar-logo-text">StudyPlan</span>
    </div>
    <div class="sidebar-perfil">⚙ Gestor Pedagógico</div>
    <nav>
        <div class="nav-label">Geral</div>
        <% var d = page==='dashboard' ? 'active' : ''; %>
        <a href="/admin" class="nav-item <%=d%>"><span class="nav-icon">📊</span> Dashboard</a>
        <div class="nav-label">Conteúdo</div>
        <% var c = page==='cursos' ? 'active' : ''; %>
        <a href="/admin/cursos" class="nav-item <%=c%>"><span class="nav-icon">🎓</span> Cursos</a>
        <% var u = page==='ucs' ? 'active' : ''; %>
        <a href="/admin/ucs" class="nav-item <%=u%>"><span class="nav-icon">📖</span> Unidades Curriculares</a>
        <% var pl = page==='plano' ? 'active' : ''; %>
        <a href="/admin/plano" class="nav-item <%=pl%>"><span class="nav-icon">🗂</span> Plano de Estudos</a>
        <div class="nav-label">Alunos</div>
        <% var f = page==='fichas' ? 'active' : ''; %>
        <a href="/admin/fichas" class="nav-item <%=f%>"><span class="nav-icon">📋</span> Fichas de Aluno</a>
    </nav>
    <div class="sidebar-user">
        <div class="user-avatar"><%=user.nome.charAt(0).toUpperCase()%></div>
        <div class="user-info">
            <strong><%=user.nome%></strong>
            <small><a href="/logout" style="color:var(--muted)">Terminar sessão</a></small>
        </div>
    </div>
</aside>
