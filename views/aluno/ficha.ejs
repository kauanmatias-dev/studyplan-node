<%- include('../partials/head', { title: 'Ficha de Aluno' }) %>
<div class="layout">
    <%- include('../partials/sidebar-aluno', { page: 'ficha' }) %>
    <main class="main">
        <div class="topbar">
            <div><h1>Ficha de Aluno</h1><p>Preencha os seus dados e submeta para validação.</p></div>
            <% if (ficha) { %>
            <span class="badge estado-<%-ficha.estado%>" style="font-size:0.85rem;padding:8px 16px"><%-ficha.estado.charAt(0).toUpperCase()+ficha.estado.slice(1)%></span>
            <% } %>
        </div>

        <% if (erro) { %><div class="alert alert-error">⚠ <%-erro%></div><% } %>
        <% if (sucesso) { %><div class="alert alert-success">✓ <%-sucesso%></div><% } %>
        <% if (ficha && ficha.estado==='rejeitada' && ficha.observacoes) { %>
        <div class="alert alert-error"><strong>Rejeitada:</strong> <%-ficha.observacoes%></div>
        <% } %>

        <% var podeEditar = !ficha || ficha.estado==='rascunho' || ficha.estado==='rejeitada'; %>

        <div class="card">
            <div class="card-header"><h3>Dados Pessoais</h3></div>
            <div class="card-body">
                <form method="POST" action="/aluno/ficha" enctype="multipart/form-data">

                    <div style="text-align:center;margin-bottom:24px">
                        <% if (ficha && ficha.foto) { %>
                            <img src="/uploads/<%-ficha.foto%>" class="foto-preview" id="preview-img">
                        <% } else { %>
                            <div class="foto-placeholder" id="preview-placeholder">👤</div>
                            <img src="" class="foto-preview" id="preview-img" style="display:none">
                        <% } %>
                        <% if (podeEditar) { %>
                        <label style="display:inline-block;margin-top:8px;cursor:pointer">
                            <span class="btn btn-secondary btn-sm" style="width:auto">📷 Alterar foto</span>
                            <input type="file" name="foto" accept="image/jpeg,image/png,image/webp" style="display:none" onchange="previewFoto(this)">
                        </label>
                        <p style="color:var(--muted);font-size:0.75rem;margin-top:6px">JPG, PNG ou WEBP · Máx. 2MB</p>
                        <% } %>
                    </div>

                    <div class="form-group">
                        <label>Curso Pretendido <span style="color:var(--danger)">*</span></label>
                        <select name="curso" <% if(!podeEditar){%>disabled<%}%> required>
                            <option value="">Selecione...</option>
                            <% cursos.forEach(function(c) { %>
                            <% var sel = ficha && ficha.curso && ficha.curso._id && ficha.curso._id.toString()===c._id.toString() ? 'selected' : ''; %>
                            <option value="<%-c._id%>" <%-sel%>><%-c.nome%></option>
                            <% }); %>
                        </select>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Data de Nascimento <span style="color:var(--danger)">*</span></label>
                            <% var dataNasc = ficha && ficha.dataNascimento ? new Date(ficha.dataNascimento).toISOString().split('T')[0] : ''; %>
                            <input type="date" name="dataNascimento" value="<%-dataNasc%>" <% if(!podeEditar){%>disabled<%}%> required>
                        </div>
                        <div class="form-group">
                            <label>Telefone <span style="color:var(--danger)">*</span></label>
                            <% var tel = ficha ? ficha.telefone||'' : ''; %>
                            <input type="tel" name="telefone" placeholder="912 345 678" value="<%-tel%>" <% if(!podeEditar){%>disabled<%}%> required>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Morada <span style="color:var(--danger)">*</span></label>
                        <% var morada = ficha ? ficha.morada||'' : ''; %>
                        <textarea name="morada" <% if(!podeEditar){%>disabled<%}%>><%-morada%></textarea>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Naturalidade</label>
                            <% var nat = ficha ? ficha.naturalidade||'' : ''; %>
                            <input type="text" name="naturalidade" placeholder="Ex: Braga" value="<%-nat%>" <% if(!podeEditar){%>disabled<%}%>>
                        </div>
                        <div class="form-group">
                            <label>Nacionalidade</label>
                            <% var nac = ficha ? ficha.nacionalidade||'Portuguesa' : 'Portuguesa'; %>
                            <input type="text" name="nacionalidade" placeholder="Ex: Portuguesa" value="<%-nac%>" <% if(!podeEditar){%>disabled<%}%>>
                        </div>
                    </div>

                    <% if (podeEditar) { %>
                    <div style="display:flex;gap:12px;margin-top:8px">
                        <button type="submit" name="acao" value="guardar" class="btn btn-secondary" style="flex:1;justify-content:center">💾 Guardar Rascunho</button>
                        <button type="submit" name="acao" value="submeter" class="btn btn-primary" style="flex:1" onclick="return confirm('Submeter a ficha? Não poderá editar depois.')">📤 Submeter</button>
                    </div>
                    <% } else { %>
                    <div class="alert alert-info" style="margin-top:8px">ℹ A ficha está em estado <strong><%-ficha.estado%></strong> e não pode ser editada.</div>
                    <% } %>

                </form>
            </div>
        </div>
    </main>
</div>
<script>
function previewFoto(input) {
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
            var img = document.getElementById('preview-img');
            var ph  = document.getElementById('preview-placeholder');
            img.src = e.target.result;
            img.style.display = 'block';
            if (ph) ph.style.display = 'none';
        };
        reader.readAsDataURL(input.files[0]);
    }
}
</script>
</body></html>
