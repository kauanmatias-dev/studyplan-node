<%- include('../partials/head', { title: 'Cursos' }) %>
<div class="layout">
    <%- include('../partials/sidebar-aluno', { page: 'cursos' }) %>
    <main class="main">
        <div class="topbar"><div><h1>Cursos Disponíveis</h1><p>Explore e submeta pedidos de matrícula.</p></div></div>

        <% if (erro) { %><div class="alert alert-error">⚠ <%= erro %></div><% } %>
        <% if (sucesso) { %><div class="alert alert-success">✓ <%= sucesso %></div><% } %>

        <% if (!ficha || ficha.estado !== 'aprovada') { %>
        <div class="alert alert-warning">
            ⚠ Para se matricular precisa de ter a ficha aprovada.
            <a href="/aluno/ficha" style="color:var(--warning);font-weight:600">
                <%= !ficha ? 'Preencher ficha →' : 'Ver estado da ficha →' %>
            </a>
        </div>
        <% } %>

        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:18px">
        <% cursos.forEach(c => {
            const mat = matriculaMap[c._id.toString()];
        %>
            <div style="background:var(--white);border:1px solid var(--border);border-radius:var(--radius);padding:22px;box-shadow:var(--shadow);display:flex;flex-direction:column;gap:12px;transition:transform 0.2s" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform=''">
                <div style="display:flex;justify-content:space-between;align-items:flex-start">
                    <h3 style="font-size:1rem;font-weight:700;line-height:1.3"><%= c.nome %></h3>
                    <span style="background:var(--accent3);color:var(--accent);font-size:0.72rem;font-weight:600;padding:3px 10px;border-radius:50px;white-space:nowrap;margin-left:8px"><%= c.duracaoAnos %> anos</span>
                </div>
                <% if (c.descricao) { %>
                    <p style="color:var(--muted);font-size:0.84rem;line-height:1.5"><%= c.descricao.substring(0,100) %><%= c.descricao.length>100?'...':'' %></p>
                <% } %>

                <% if (mat && mat.estado === 'aprovada') { %>
                    <span class="badge badge-green">✓ Matriculado</span>
                <% } else if (mat && mat.estado === 'pendente') { %>
                    <span class="badge badge-amber">⏳ Pedido pendente</span>
                <% } else if (mat && mat.estado === 'rejeitada') { %>
                    <span class="badge badge-red">✕ Pedido rejeitado</span>
                    <form method="POST" action="/aluno/cursos/matricular">
                        <input type="hidden" name="curso" value="<%= c._id %>">
                        <input type="hidden" name="anoLetivo" value="<%= new Date().getFullYear() %>/<%= new Date().getFullYear()+1 %>">
                        <button type="submit" class="btn btn-secondary btn-sm" style="width:100%;justify-content:center">Novo pedido</button>
                    </form>
                <% } else { %>
                    <form method="POST" action="/aluno/cursos/matricular">
                        <input type="hidden" name="curso" value="<%= c._id %>">
                        <input type="hidden" name="anoLetivo" value="<%= new Date().getFullYear() %>/<%= new Date().getFullYear()+1 %>">
                        <button type="submit" class="btn btn-primary btn-sm" <%= (!ficha||ficha.estado!=='aprovada')?'disabled':'' %>>Pedir Matrícula</button>
                    </form>
                <% } %>
            </div>
        <% }) %>
        </div>
    </main>
</div>
</body></html>
