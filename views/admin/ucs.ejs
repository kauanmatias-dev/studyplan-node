<%- include('../partials/head', { title: 'Unidades Curriculares' }) %>
<div class="layout">
    <%- include('../partials/sidebar-admin', { page: 'ucs' }) %>
    <main class="main">
        <div class="topbar">
            <div><h1>Unidades Curriculares</h1><p>Gira todas as UCs disponíveis.</p></div>
            <button class="btn btn-primary" style="width:auto" onclick="document.getElementById('modal-uc').classList.add('open')">+ Nova UC</button>
        </div>

        <% if (typeof sucesso !== 'undefined' && sucesso) { %><div class="alert alert-success">✓ <%= sucesso %></div><% } %>

        <div class="card">
            <div class="card-header"><h3>Todas as UCs (<%= ucs.length %>)</h3></div>
            <% if (ucs.length > 0) { %>
            <table>
                <thead><tr><th>Nome</th><th>Créditos</th><th>Horas/semana</th><th>Ações</th></tr></thead>
                <tbody>
                <% ucs.forEach(u => { %>
                <tr>
                    <td><strong><%= u.nome %></strong><br><small style="color:var(--muted)"><%= (u.descricao||'').substring(0,50) %></small></td>
                    <td><%= u.creditos %> ECTS</td>
                    <td><%= u.horasSemana %>h</td>
                    <td><a href="/admin/ucs/apagar/<%= u._id %>" class="btn btn-danger btn-xs" onclick="return confirm('Apagar esta UC?')">Apagar</a></td>
                </tr>
                <% }) %>
                </tbody>
            </table>
            <% } else { %>
            <div class="empty-state"><div class="empty-icon">📖</div><p>Nenhuma UC ainda.</p></div>
            <% } %>
        </div>
    </main>
</div>

<div class="modal-overlay" id="modal-uc">
    <div class="modal">
        <div class="modal-header"><h3>Nova Unidade Curricular</h3><button class="modal-close" onclick="document.getElementById('modal-uc').classList.remove('open')">✕</button></div>
        <form method="POST" action="/admin/ucs/criar">
            <div class="form-group"><label>Nome da UC</label><input type="text" name="nome" required placeholder="Ex: Programação Web II"></div>
            <div class="form-group"><label>Descrição</label><textarea name="descricao" placeholder="Descrição..."></textarea></div>
            <div class="form-row">
                <div class="form-group"><label>Créditos ECTS</label><input type="number" name="creditos" value="6" min="1" max="30"></div>
                <div class="form-group"><label>Horas/semana</label><input type="number" name="horasSemana" value="4" min="1" max="20"></div>
            </div>
            <button type="submit" class="btn btn-primary">Criar UC</button>
        </form>
    </div>
</div>
</body></html>
